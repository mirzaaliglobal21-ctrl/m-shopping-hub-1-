{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Product listing with details, pricing and store link",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "currency": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "directPurchaseUrl": { "type": "string" },
        "likesCount": { "type": "number" },
        "savesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "price", "currency", "category", "imageUrl", "directPurchaseUrl", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Product review or comment submitted by user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "productId", "userId", "userName", "text", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with interaction history and saved wishlist items",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of products available on M Shopping Hub"
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Collection of user reviews and comments"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile details and settings"
    }
  }
}
