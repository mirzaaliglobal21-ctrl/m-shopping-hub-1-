rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Products collection: public read, write allowed for management and counts
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Comments collection: public read, create allowed for user comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid);
    }

    // User profiles & activity
    match /users/{userId} {
      allow read, write: if true;
    }

    // Analytics summary and visitor tracking
    match /analytics/{docId} {
      allow read, write: if true;
    }

    // Real-time visitor activity logs
    match /visitors/{visitorId} {
      allow read, write: if true;
    }
  }
}
